import { Button, ScrollView } from "std-widgets.slint";

export struct LayerInfo {
    id: string,
    image: image,
    selection-order: int,
}

component StackedPanel inherits Rectangle {
    in property <string> label;
    in property <[LayerInfo]> stack;
    in property <bool> highlighted;

    border-radius: 8px;
    border-width: 2px;
    border-color: highlighted ? #4CAF50 : #555;
    background: #1a1a2e;
    clip: true;

    Text {
        text: label;
        color: highlighted ? #4CAF50 : #aaa;
        font-size: 11px;
        horizontal-alignment: center;
        height: 18px;
        x: 0;
        y: 4px;
        width: parent.width;
    }

    for layer in stack: Image {
        source: layer.image;
        x: 2px;
        y: 24px;
        width: parent.width - 4px;
        height: parent.height - 28px;
        image-fit: contain;
    }
}

component LayerThumb inherits Rectangle {
    in property <LayerInfo> layer-info;
    callback clicked();

    property <bool> selected: layer-info.selection-order > 0;

    border-radius: 6px;
    border-width: selected ? 3px : 1px;
    border-color: selected ? #FFD700 : #444;
    background: selected ? #2a2a1e : #16213e;
    clip: true;

    Image {
        source: layer-info.image;
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        image-fit: contain;
    }

    if selected: Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: #FFD700;
        x: parent.width - 28px;
        y: 4px;

        Text {
            text: layer-info.selection-order;
            color: #000;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component LayerGrid inherits Rectangle {
    in property <[LayerInfo]> layers;
    callback layer-clicked(int);

    property <int> cols: 4;
    property <length> cell: 88px;
    property <length> gap: 8px;

    width: cols * cell + (cols - 1) * gap;
    height: ((layers.length + cols - 1) / cols) * (cell + gap);

    for layer[idx] in layers: LayerThumb {
        x: Math.mod(idx, cols) * (root.cell + root.gap);
        y: (idx / cols) * (root.cell + root.gap);
        width: root.cell;
        height: root.cell;
        layer-info: layer;
        clicked => { root.layer-clicked(idx); }
    }
}

export component AppWindow inherits Window {
    title: "Stencillogici";
    min-width: 400px;
    min-height: 600px;
    background: #0f0f23;

    in property <[LayerInfo]> layers;
    in property <[LayerInfo]> target-stack;
    in property <[LayerInfo]> composite-stack;
    in property <bool> solved: false;

    callback layer-clicked(int);
    callback reset-clicked();
    callback next-level-clicked();

    property <bool> landscape: self.width > self.height;

    // Win overlay
    if solved: Rectangle {
        z: 100;
        width: root.width;
        height: root.height;
        background: #00000099;

        VerticalLayout {
            alignment: center;
            spacing: 24px;

            Text {
                text: "Solved!";
                color: #FFD700;
                font-size: 48px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 16px;

                Button {
                    text: "Play Again";
                    clicked => { root.reset-clicked(); }
                }

                Button {
                    text: "Next Level";
                    clicked => { root.next-level-clicked(); }
                }
            }
        }
    }

    if !landscape: VerticalLayout {
        padding: 12px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            height: root.height * 0.38;

            StackedPanel {
                label: "Target";
                stack: root.target-stack;
                highlighted: false;
            }

            StackedPanel {
                label: root.solved ? "Composite ✓" : "Composite";
                stack: root.composite-stack;
                highlighted: root.solved;
            }
        }

        ScrollView {
            height: root.height - root.height * 0.38 - 40px - 36px;
            LayerGrid {
                layers: root.layers;
                layer-clicked(idx) => { root.layer-clicked(idx); }
            }
        }

        Button {
            text: "Reset";
            height: 40px;
            clicked => { root.reset-clicked(); }
        }
    }

    if landscape: HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        VerticalLayout {
            width: root.width * 0.38;
            spacing: 12px;

            StackedPanel {
                label: "Target";
                stack: root.target-stack;
                highlighted: false;
            }

            StackedPanel {
                label: root.solved ? "Composite ✓" : "Composite";
                stack: root.composite-stack;
                highlighted: root.solved;
            }
        }

        VerticalLayout {
            spacing: 12px;

            ScrollView {
                LayerGrid {
                    layers: root.layers;
                    layer-clicked(idx) => { root.layer-clicked(idx); }
                }
            }

            Button {
                text: "Reset";
                height: 40px;
                clicked => { root.reset-clicked(); }
            }
        }
    }
}
